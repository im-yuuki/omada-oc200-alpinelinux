/*
 * OC200 (TP-Link OC200) board description, derived from the Marvell
 * Armada 3720 community/ECK reference DTS (2016 Marvell license above).
 *
 * This file is a MODIFIED derivative, not an unmodified upstream file.
 * The base reference DTS is not present in the linux-6.18.59 tarball, so
 * this list is written by hand, not generated with diff. Every change that
 * is specific to the OC200 is tagged "OC200 MOD" in the body.
 *
 * Summary of modifications:
 *   1. Model and compatible: TP-Link OC200 identity added first.
 *   2. Memory: 1 GiB (0x40000000 bytes).
 *   3. System LED and reset-button pin groups moved from a separate
 *      south-bridge-pinctrl node into &pinctrl_sb (deferred-probe fix).
 *   4. gpio-leds and gpio-keys: OC200 GPIO assignments; LED uses the
 *      disk-activity trigger.
 *   5. eth0: CPU link fixed at 100 Mbps full duplex, pause not advertised.
 *   6. mdio: AR8236 switch node (CPU port 0 to eth0, user ports swp1/swp2).
 *   7. USB2/USB3, UART0, I2C0/I2C1, SPI0 flash, eMMC (sdhci0): enabled
 *      with OC200-specific settings.
 *
 * Items marked "not verified against base" are believed to be OC200 changes
 * but have not been compared against the base reference file.
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include "armada-372x.dtsi"

/ {
	/* OC200 MOD: model and first compatible changed to the OC200 identity;
	 * the ECK board strings are kept as fallbacks. */
	model = "Marvell Armada 3720 ECK Board";
	compatible = "tplink,oc200", "marvell,armada-3720-oc200", "marvell,armada-3720-eck", "marvell,armada3720", "marvell,armada3710";

	aliases {
		mmc0 = &sdhci0;
	};

	chosen {
		bootargs = "console=ttyMV0,115200";
		stdout-path = "serial0:115200n8";
	};

	/* OC200 MOD: 1 GiB DRAM (U-Boot reports DRAM: 1 GiB). */
	memory {
		device_type = "memory";
		reg = <0x00000000 0x00000000 0x00000000 0x40000000>;
	};

	soc {
		internal-regs {
			reg_avs: avs@11500 {
				status = "okay";
			};

			/* Pin groups moved to &pinctrl_sb below (fixes
			 * leds-gpio / gpio-keys deferred probe: the pinctrl
			 * subsystem requires pin-group nodes to be children
			 * of the actual pinctrl device node). */

			u3d@50000 {
				status = "disabled";
				//phys = <&a3700_comphy 0 COMPHY_USB3>;
				phy-names = "usb";
			};

			udc@54100 {
				status = "disabled";
				//phys = <&utmi_usb32>;
				phy-names = "usb";
			};

			usb3@58000 {
				status = "okay";
			};

			usb2@5e000 {
				status = "okay";
			};

			utmi_usb32: utmi@5d000 {
				status = "okay";
			};

			utmi_usb2: utmi@5f000 {
				status = "okay";
			};

			vcc_sd_reg1: regulator@0 {
				compatible = "regulator-gpio";
				regulator-name = "vcc_sd1";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;

				gpios = <&gpionb 4 GPIO_ACTIVE_HIGH>;
				gpios-states = <0>;
				states = <1800000 0x1
					  3300000 0x0>;

				enable-active-high;
			};


			bm: bm@c0000 {
				compatible = "marvell,armada-380-neta-bm";
				reg = <0xc0000 0xac>;
				clocks = <&sb_periph_clk 9>;
				internal-mem = <&bm_bppi>;
				status = "okay";
			};

			bm_bppi: bm-bppi {
				compatible = "mmio-sram";
				reg = <0xc8000 0x1000>;
				clocks = <&sb_periph_clk 9>;
				no-memory-wc;
				status = "okay";
			};

			eip97: eip97@90000 {
				status = "okay";
			};
		};
	};



	/* OC200 MOD: system LED on GPIO SB 1 (mpp1); the disk-activity trigger is
	 * an OC200 choice, not in the base file. */
	gpio-leds {
		compatible = "gpio-leds";
		pinctrl-0 = <&system_led_pins>;
		pinctrl-names = "default";

		system-led {
			label = "system-led";
			gpios = <&gpiosb 1 GPIO_ACTIVE_HIGH>;
			default-state = "off";
			linux,default-trigger = "disk-activity";
		};
	};

	/* OC200 MOD: reset button on GPIO SB 4 (mpp4), active low, mapped to
	 * KEY_RESTART. */
	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&system_reset_pins>;
		pinctrl-names = "default";

		reset-button {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&gpiosb 4 GPIO_ACTIVE_LOW>;
		};
	};
};

&spi0 {
	status = "okay";

	spi-flash@0 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "jedec,spi-nor";
		reg = <0>; /* Chip select 0 */
		spi-max-frequency = <104000000>;
		m25p,fast-read;

		pinctrl-names = "default";
		pinctrl-0 = <&spi_cs1_pins &spi_quad_pins>;
	};
};

&uart0 {
	status = "okay";
};

/* Enable the actual Armada 37xx host-controller nodes inherited from dtsi. */
&usb3 {
	status = "okay";
};

&usb2 {
	status = "okay";
};

&i2c0 {
	status = "okay";
};

&i2c1 {
	status = "okay";
};

/* OC200 MOD: eth0 is the CPU port to the AR8236 switch. The fixed link is
 * 100 Mbps full duplex, and pause is not advertised ("//pause;" below is
 * commented out). See docs/notes/OC200_AR8236_IPERF_INVESTIGATION.md. */
&eth0 {
	phy-mode = "rgmii";
	status = "okay";
	buffer-manager = <&bm>;
	bm,pool-long = <1>;
	bm,pool-short = <3>;

	fixed-link {
		speed = <100>;
		full-duplex;
		//pause;
	};

};

/* OC200 MOD: AR8236 10/100 switch on the MDIO bus. Port 0 is the CPU port
 * (eth0). swp1 and swp2 are the user ports. This node does not exist in the
 * base reference file. The driver is in drivers/net/dsa/qca/ar8236.c. */
&mdio {
	switch0: switch@0 {
		compatible = "qca,ar8236";
		dsa,member = <0 0>;
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				ethernet = <&eth0>;
				phy-mode = "rgmii";

				fixed-link {
					speed = <100>;
					full-duplex;
				};
			};

			port@1 {
				reg = <1>;
				label = "swp1";
			};

			port@2 {
				reg = <2>;
				label = "swp2";
			};
		};
	};
};

&sdhci0 {
	marvell,pad-type = "fixed-1-8v";
	non-removable;
	bus-width = <8>;
	cap-mmc-highspeed;
	max-frequency = <52000000>;
	marvell,xenon-emmc;
	marvell,xenon-broken-hs200;
	marvell,xenon-tun-count = <9>;
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&mmc_pins>;
	#address-cells = <1>;
	#size-cells = <0>;
	mmc0: mmccard@0 {
		compatible = "mmc-card";
		reg = <0>;
	};
};

/* SB pin groups for the system LED and reset button.
 * These MUST be children of the pinctrl_sb device node so that
 * pinctrl_bind_pins() can resolve them; the old placement under a
 * separate south-bridge-pinctrl@18830 node caused leds-gpio and
 * gpio-keys to defer forever. */
&pinctrl_sb {
	system_led_pins: system-led-pins {
		marvell,pins = "mpp1";
		marvell,function = "gpio";
	};

	system_reset_pins: system-reset-pins {
		marvell,pins = "mpp4";
		marvell,function = "gpio";
	};
};
