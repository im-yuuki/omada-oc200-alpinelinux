#!/sbin/openrc-run

description="512 MiB compressed swap in RAM"

depend() {
    need localmount
    before swap
}

start() {
    ebegin "Starting zram swap"
    (
        set -e
        echo lzo-rle > /sys/block/zram0/comp_algorithm
        echo 536870912 > /sys/block/zram0/disksize
        mkswap /dev/zram0 >/dev/null
        swapon /dev/zram0
    )
    eend $?
}

stop() {
    ebegin "Stopping zram swap"
    swapoff /dev/zram0 && echo 1 > /sys/block/zram0/reset
    eend $?
}
