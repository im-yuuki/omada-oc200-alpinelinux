#!/sbin/openrc-run
description="512 MiB compressed zram swap"

depend() {
	need localmount
}

start() {
	ebegin "Activating 512 MiB zram swap"
	if grep -q '^/dev/zram0 ' /proc/swaps; then
		eend 0
		return 0
	fi
	if [ ! -e /sys/block/zram0/disksize ] || [ ! -e /dev/zram0 ]; then
		eend 1
		return 1
	fi
	if [ "$(cat /sys/block/zram0/disksize)" = 0 ]; then
		echo 536870912 > /sys/block/zram0/disksize || { eend 1; return 1; }
		mkswap /dev/zram0 >/dev/null || { echo 1 > /sys/block/zram0/reset; eend 1; return 1; }
	fi
	swapon -p 100 /dev/zram0
	eend $?
}

stop() {
	ebegin "Deactivating zram swap"
	if grep -q '^/dev/zram0 ' /proc/swaps; then
		swapoff /dev/zram0 || { eend 1; return 1; }
	fi
	if [ -e /sys/block/zram0/reset ]; then
		echo 1 > /sys/block/zram0/reset || { eend 1; return 1; }
	fi
	eend 0
}
